# SimpleCDC Environment Configuration
# =====================================

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=app

# Database connection (used by backend + cdc-worker)
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=app

# Backend
API_TOKEN=changeme


# CDC Worker
SLOT_NAME=simplecdc_slot
PUBLICATION_NAME=simplecdc_pub
POLL_INTERVAL=0.1
